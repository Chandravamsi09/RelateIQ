# RelateIQ Enterprise CRM - Environment Configuration Example
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:3000

# Database Connection (PostgreSQL or SQLite)
DATABASE_URL="postgresql://relateiq_user:relateiq_password@localhost:5432/relateiq_db?schema=public"

# Multi-Tenant JWT Security
JWT_SECRET=super_secret_jwt_signing_key_replace_in_production
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_EXPIRES_IN=7d

# Cryptography Master Key (AES-256-GCM hex)
CRYPTO_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Redis Cache & Event Bus (Optional)
REDIS_HOST=localhost
REDIS_PORT=6379
