# RelateIQ Enterprise CRM - Environment Configuration Example
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:3000

# Database Connection (PostgreSQL or SQLite)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB_NAME?schema=public"

# Multi-Tenant JWT Security
JWT_SECRET=YOUR_JWT_SECRET_KEY_HERE
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_EXPIRES_IN=7d

# Cryptography Master Key (AES-256-GCM hex)
CRYPTO_MASTER_KEY=YOUR_64_HEX_CHARACTER_ENCRYPTION_KEY_HERE

# Redis Cache & Event Bus (Optional)
REDIS_HOST=localhost
REDIS_PORT=6379
